{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/accounting_document.schema.json",
  "title": "AccountingDocument",
  "type": "object",
  "required": ["document_type", "currency", "amounts", "lines"],
  "properties": {
    "document_type": {
      "type": "string",
      "enum": ["invoice", "receipt", "credit_note", "expense_note", "unknown"]
    },
    "supplier": {"$ref": "#/$defs/party"},
    "customer": {"$ref": "#/$defs/party"},
    "employee": {"$ref": "#/$defs/party"},
    "document_number": {"type": ["string", "null"]},
    "issue_date": {"type": ["string", "null"], "format": "date"},
    "due_date": {"type": ["string", "null"], "format": "date"},
    "currency": {"type": "string", "minLength": 3, "maxLength": 3},
    "business_purpose": {"type": ["string", "null"]},
    "project_code": {"type": ["string", "null"]},
    "reimbursable": {"type": ["boolean", "null"]},
    "amounts": {"$ref": "#/$defs/amounts"},
    "tax_breakdown": {
      "type": "array",
      "items": {"$ref": "#/$defs/taxLine"}
    },
    "lines": {
      "type": "array",
      "items": {"$ref": "#/$defs/line"}
    },
    "field_confidence": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "category_prediction": {"$ref": "#/$defs/categoryPrediction"}
  },
  "$defs": {
    "party": {
      "type": ["object", "null"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "vat_number": {"type": ["string", "null"]},
        "address": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "amounts": {
      "type": "object",
      "required": ["total"],
      "properties": {
        "subtotal": {"type": ["number", "null"]},
        "tax": {"type": ["number", "null"]},
        "total": {"type": "number"}
      },
      "additionalProperties": false
    },
    "taxLine": {
      "type": "object",
      "properties": {
        "rate": {"type": ["number", "null"]},
        "taxable": {"type": ["number", "null"]},
        "tax": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    },
    "line": {
      "type": "object",
      "required": ["description", "total"],
      "properties": {
        "description": {"type": "string"},
        "quantity": {"type": ["number", "null"]},
        "unit_price": {"type": ["number", "null"]},
        "total": {"type": "number"},
        "tax_rate": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    },
    "categoryPrediction": {
      "type": ["object", "null"],
      "properties": {
        "account_code": {"type": "string"},
        "label": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source": {
          "type": "string",
          "enum": ["rule", "client_vendor_history", "classifier", "llm", "human"]
        }
      },
      "required": ["account_code", "label", "confidence", "source"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
