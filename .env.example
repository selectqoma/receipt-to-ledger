# Multimodal document extraction (PDFs/images)
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=low
GEMINI_MEDIA_RESOLUTION=auto
# Optional price overrides, USD per 1M tokens:
# GEMINI_INPUT_USD_PER_M=1.50
# GEMINI_OUTPUT_USD_PER_M=7.50

# Ledger categorization + text/XML extraction
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional price overrides, USD per 1M tokens:
# DEEPSEEK_INPUT_USD_PER_M=0.14
# DEEPSEEK_OUTPUT_USD_PER_M=0.28

# Only used by the local debug/fallback OCR path
TESSERACT_LANG=eng
